# CloudBase 接入配置模板 —— 复制为 .env.development / .env.production 后填入真实值
# 真实 env 文件已被 .gitignore 忽略，请勿提交密钥。

# CloudBase 环境 ID（可填现有环境或新建环境后替换）
VITE_CLOUDBASE_ENV_ID=your-env-id

# ⚠️ 必须是「客户端 publishable key」，禁止用 service_role 密钥！
#   - 创建位置：CloudBase 控制台 → 环境 → 访问控制 → API 密钥管理 → 新建
#   - 选「客户端密钥 / publishable」类型；服务端密钥(service_role)一旦打进前端产物，
#     任何解包 app.asar 的人都能提取，可凭它调用 CloudBase 管理 API，属于高危泄露。
#   - 仅作 SDK 初始化，登录走自建 JWT；业务数据读写由 data-api 云函数收口。
VITE_CLOUDBASE_ACCESS_KEY=your-publishable-key

# region
VITE_CLOUDBASE_REGION=ap-shanghai

# 自建 auth-otp HTTP function 根 URL
VITE_AUTH_OTP_URL=https://your-env-id.service.tcloudbase.com/auth-otp

# 管理员后台 data-api HTTP function 根 URL（管理员菜单可见 + 鉴权校验）
VITE_DATA_API_URL=https://your-env-id.service.tcloudbase.com/data-api
